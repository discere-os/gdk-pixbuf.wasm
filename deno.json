{
  "name": "@discere-os/gdk-pixbuf.wasm",
  "version": "2.43.6",
  "description": "GNOME image loading library for WASM - Discere OS",
  "exports": {
    ".": "./",
    "./side": "./install/wasm/gdk-pixbuf-side.wasm",
    "./main": "./install/wasm/gdk-pixbuf-main.js"
  },
  "tasks": {
    "build:wasm": "bash scripts/unified-build.sh standard",
    "build:minimal": "bash scripts/unified-build.sh minimal",
    "build:webgpu": "bash scripts/unified-build.sh webgpu",
    "build:clean": "CLEAN=true bash scripts/unified-build.sh standard",
    "build:size": "OPTIMIZE=size bash scripts/unified-build.sh minimal",
    "build:speed": "OPTIMIZE=speed bash scripts/unified-build.sh standard",
    "clean": "rm -rf build build-* install",
    "demo": "deno run --allow-read demo-deno.ts",
    "test": "deno test --allow-read tests/deno/",
    "manifest": "deno run --allow-read --allow-write --allow-run ../../../../scripts/generate-wasm-manifest.ts .",
    "start:proxy": "python3 $(which emcc)/../tools/websocket_to_posix_proxy/websocket_to_posix_proxy.py"
  }
}
